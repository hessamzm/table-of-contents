msgstr "کارت"

msgid "Configure automatic TOC rendering and its global appearance."
msgstr "نمایش خودکار فهرست مطالب و ظاهر کلی آن را تنظیم کنید."

msgid "You do not have permission to access this page."
msgstr "شما اجازه دسترسی به این صفحه را ندارید."

msgid "Use a CSS length such as 16px, 1rem, or 1.5em."
msgstr "یک مقدار CSS مانند 16px، 1rem یا 1.5em وارد کنید."

msgid "Global setting"
msgstr "تنظیم عمومی"

msgid "Override the global numbering setting."
msgstr "تنظیم شماره‌گذاری عمومی را نادیده بگیرید."

msgid "Leave all heading levels unchecked to use the global selection."
msgstr "برای استفاده از انتخاب سطوح عمومی، همه سطوح عنوان را بدون علامت بگذارید."

msgid "The table of contents will be generated on the front end from this post’s headings."
msgstr "فهرست مطالب در بخش کاربری بر اساس عنوان‌های این نوشته تولید می‌شود."

msgid "Display a manually placed table of contents."
msgstr "نمایش یک فهرست مطالب که به‌صورت دستی قرار داده شده است."

msgid "Paper Menu"
msgstr "منوی کاغذی"

msgid "TOC position"
msgstr "موقعیت فهرست مطالب"

msgid "View more text"
msgstr "متن مشاهده بیشتر"

msgid "View less text"
msgstr "متن مشاهده کمتر"

msgid "Right"
msgstr "راست"

msgid "Left"
msgstr "چپ"

msgid "Choose which side of the content the TOC is aligned to."
msgstr "مشخص کنید فهرست مطالب در کدام سمت محتوای اصلی قرار بگیرد."

msgid "View more"
msgstr "مشاهده بیشتر"

msgid "View less"
msgstr "مشاهده کمتر"

msgid "Sticky TOC font size"
msgstr "اندازه فونت فهرست مطالب چسبیده"

msgid "Live preview"
msgstr "پیش‌نمایش زنده"

msgid "Preview the TOC while you customize its appearance. Changes are shown instantly and are saved when you click Save Changes."
msgstr "هنگام سفارشی‌سازی ظاهر فهرست مطالب، پیش‌نمایش آن را مشاهده کنید. تغییرات بلافاصله نمایش داده می‌شوند و با کلیک روی ذخیره تغییرات ذخیره خواهند شد."

msgid "Introduction"
msgstr "مقدمه"

msgid "Getting Started"
msgstr "شروع کار"

msgid "Configuration"
msgstr "پیکربندی"

msgid "Advanced Settings"
msgstr "تنظیمات پیشرفته"

msgid "Conclusion"
msgstr "جمع‌بندی"

msgid "Subsection example"
msgstr "نمونه زیربخش"

msgid "Shortcode"
msgstr "کد کوتاه"

msgid "Basic shortcode"
msgstr "کد کوتاه پایه"

msgid "Advanced shortcode"
msgstr "کد کوتاه پیشرفته"

msgid "Copy one of these shortcodes and paste it into a post, page, widget, or shortcode-capable editor."
msgstr "یکی از این کدهای کوتاه را کپی کرده و در نوشته، برگه، ابزارک یا ویرایشگری که از کد کوتاه پشتیبانی می‌کند قرار دهید."

msgid "Uses the global TOC settings and the current content."
msgstr "از تنظیمات عمومی فهرست مطالب و محتوای جاری استفاده می‌کند."

msgid "Optional attributes: levels, title, style, and numbers."
msgstr "ویژگی‌های اختیاری: levels، title، style و numbers."

msgid "Displays a table of contents generated from the current post or product content."
msgstr "فهرست مطالب تولیدشده از محتوای نوشته یا محصول جاری را نمایش می‌دهد."

msgid "This widget uses the current post or product content and the global TOC settings."
msgstr "این ابزارک از محتوای نوشته یا محصول جاری و تنظیمات عمومی فهرست مطالب استفاده می‌کند."

msgid "Content types"
msgstr "نوع محتوا"

msgid "Blog posts"
msgstr "نوشته‌های وبلاگ"

msgid "WooCommerce products"
msgstr "محصولات ووکامرس"

msgid "Articles"
msgstr "مقالات"

msgid "Enable TOC"
msgstr "فعال‌سازی فهرست مطالب"

msgid "Generate a dedicated TOC for WooCommerce product descriptions."
msgstr "یک فهرست مطالب اختصاصی برای توضیحات محصولات ووکامرس ایجاد می‌کند."

msgid "Generate a dedicated TOC for blog posts."
msgstr "یک فهرست مطالب اختصاصی برای نوشته‌های وبلاگ ایجاد می‌کند."

msgid "Alignment"
msgstr "تراز"

msgid "TOC placement"
msgstr "محل قرارگیری فهرست مطالب"

msgid "Shortcode generators"
msgstr "سازنده‌های کد کوتاه"

msgid "Build a ready-to-use shortcode without memorizing attributes. Each generator uses the settings for its own TOC profile as the starting point."
msgstr "یک کد کوتاه آماده استفاده بسازید، بدون اینکه لازم باشد ویژگی‌ها را به خاطر بسپارید. هر سازنده از تنظیمات پروفایل فهرست مطالب مربوط به خود به‌عنوان نقطه شروع استفاده می‌کند."

msgid "Blog TOC shortcode"
msgstr "کد کوتاه فهرست مطالب وبلاگ"

msgid "Use this shortcode inside a blog post to insert the Blog TOC manually."
msgstr "از این کد کوتاه داخل یک نوشته وبلاگ برای درج دستی فهرست مطالب وبلاگ استفاده کنید."

msgid "Product TOC shortcode"
msgstr "کد کوتاه فهرست مطالب محصول"

msgid "Use this shortcode inside a WooCommerce product to insert the Product TOC manually."
msgstr "از این کد کوتاه داخل یک محصول ووکامرس برای درج دستی فهرست مطالب محصول استفاده کنید."

msgid "Generated shortcode"
msgstr "کد کوتاه تولیدشده"

msgid "Copy shortcode"
msgstr "کپی کد کوتاه"

msgid "Copied"
msgstr "کپی شد"

msgid "General plugin settings. Blog posts and products are enabled and configured independently in their respective tabs."
msgstr "تنظیمات عمومی افزونه. فعال‌سازی و پیکربندی نوشته‌های وبلاگ و محصولات به‌صورت مستقل در تب‌های مربوط به خود انجام می‌شود."

msgid "Create and customize the TOC used specifically for blog posts. These settings are independent from the product TOC."
msgstr "فهرست مطالب مخصوص نوشته‌های وبلاگ را ایجاد و سفارشی کنید. این تنظیمات مستقل از فهرست مطالب محصولات هستند."

msgid "Create and customize the TOC used specifically for WooCommerce products. These settings are independent from the article TOC."
msgstr "فهرست مطالب مخصوص محصولات ووکامرس را ایجاد و سفارشی کنید. این تنظیمات مستقل از فهرست مطالب مقالات هستند."

msgid "Table of Contents settings"
msgstr "تنظیمات فهرست مطالب"

msgid "Leave empty to use the global plugin title."
msgstr "برای استفاده از عنوان عمومی افزونه، این قسمت را خالی بگذارید."

msgid "This widget uses the current post or product content and its independent TOC profile settings."
msgstr "این ابزارک از محتوای نوشته یا محصول جاری و تنظیمات مستقل فهرست مطالب مربوط به آن استفاده می‌کند."

msgid "Delete plugin settings when the plugin is permanently uninstalled."
msgstr "هنگام حذف کامل افزونه، تنظیمات افزونه را حذف می‌کند."

msgid "Inside product description"
msgstr "داخل توضیحات محصول"

msgid "Before product summary"
msgstr "قبل از خلاصه محصول"

msgid "After product tabs"
msgstr "بعد از تب‌های محصول"
