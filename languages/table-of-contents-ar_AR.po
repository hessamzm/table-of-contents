msgstr "بطاقة"

msgid "Configure automatic TOC rendering and its global appearance."
msgstr "إعداد عرض فهرس المحتويات التلقائي ومظهره العام."

msgid "You do not have permission to access this page."
msgstr "ليس لديك صلاحية للوصول إلى هذه الصفحة."

msgid "Use a CSS length such as 16px, 1rem, or 1.5em."
msgstr "استخدم قيمة لطول CSS مثل 16px أو 1rem أو 1.5em."

msgid "Global setting"
msgstr "الإعداد العام"

msgid "Override the global numbering setting."
msgstr "تجاوز عن إعداد الترقيم العام."

msgid "Leave all heading levels unchecked to use the global selection."
msgstr "اترك جميع مستويات العناوين بدون تحديد لاستخدام الاختيار العام."

msgid "The table of contents will be generated on the front end from this post’s headings."
msgstr "سيتم إنشاء فهرس المحتويات في الواجهة الأمامية استنادًا إلى عناوين هذا المقال."

msgid "Display a manually placed table of contents."
msgstr "عرض فهرس محتويات موضوع يدويًا."

msgid "Paper Menu"
msgstr "قائمة ورقية"

msgid "TOC position"
msgstr "موضع فهرس المحتويات"

